# Create a key in Garmin Connect (web) → Account settings → Personal API Key.
# It is shown once. Paste it here, in a file named .env (never commit it).
GARMIN_API_KEY=

# Optional: earliest date to pull daily health data from (YYYY-MM-DD).
# Defaults to the date of your first activity.
# GARMIN_HISTORY_START=2012-01-01

# Optional: port for the local server (default 5173)
# PORT=5173
